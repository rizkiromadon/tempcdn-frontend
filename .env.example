NEXT_PUBLIC_TEMPCDN_API_BASE=http://localhost:8080/api/v1

# Optional: comma-separated list of API base URLs to round-robin across
# multiple backend instances, with automatic failover to the next one on a
# network error, timeout, or 5xx response. Takes precedence over
# NEXT_PUBLIC_TEMPCDN_API_BASE above when set. Every base must point at an
# instance sharing the same metadata store as the others (see the backend
# README's "Running Multiple Instances" section) - otherwise a request
# that round-robins to a different server than an earlier one won't find
# the record it's looking for.
# NEXT_PUBLIC_TEMPCDN_API_BASES=https://srv1.tempcdn.eu.cc/api/v1,https://srv2.tempcdn.eu.cc/api/v1,https://srv3.tempcdn.eu.cc/api/v1

# Public origin this frontend is deployed at. Used for absolute URLs in
# metadata (Open Graph / Twitter Card canonical + image URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hostname (no protocol) that uploaded files' cdn_url values are served
# from, e.g. "cdn.tempcdn.example.com". Used to scope next/image's
# remotePatterns so the built-in image optimizer only ever proxies the
# real CDN, not arbitrary HTTPS hosts.
NEXT_PUBLIC_TEMPCDN_CDN_HOST=localhost
